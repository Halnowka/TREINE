rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // PERMISSIVE RULES FOR DEBUGGING - Temporarily allow all authenticated users
    // TODO: Restore proper security rules after debugging

    // Allow authenticated users to read/write in user subcollections
    match /users/{userId} {
      allow read, write: if isAuthenticated();
      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Allow authenticated users to read/write in legacy collections
    match /weights/{document} {
      allow read, write: if isAuthenticated();
    }

    match /workouts/{document} {
      allow read, write: if isAuthenticated();
    }

    match /userProgress/{document} {
      allow read, write: if isAuthenticated();
    }

    // Public exercise definitions
    match /exercises/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
